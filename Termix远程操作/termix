#!/usr/bin/env node
'use strict';
// termix — 一行命令操作 Termix 里登记的服务器
//
// 用法:
//   termix ls [--json]
//   termix run <id|名称|IP> <命令>
//   termix run --cred <凭据id> <IP> <命令>    # 未登记进 Termix 的机器
//   termix run --trust <目标> <命令>          # 接受变更过的 host key
//
// 令牌: 环境变量 TERMIX_TOKEN，或 ~/.termix-token

const fs = require('fs');
const os = require('os');
const path = require('path');
const http = require('http');
const https = require('https');
const WebSocket = require('ws');

const VERSION = '1.1.0';
const DEFAULT_URL = 'https://termix.xct258.top';

const BEGIN = '__TMX_BEGIN__';
const END = '__TMX_END__';
// 下发时带引号，由远端 shell 去掉引号后才变成真正的标记；
// 这样 PTY 回显的那一行和被解析的标记行不同，回显不会污染结果。
const BEGIN_W = '__TMX_"BEG"IN__';
const END_W = '__TMX_"EN"D__';

const REQUEST_TIMEOUT = 30; // API 请求超时（秒）
const MAX_OUTPUT = 32 * 1024 * 1024; // 输出缓冲上限
const MAX_BUFFER_KEEP = 4096; // 连接异常关闭时最多回显的字节数

let BASE = null; // URL
let TOKEN = '';
let activeSocket = null;

// ---------------------------------------------------------------- 工具

const envNum = (k, d) => {
  const n = Number(process.env[k]);
  return Number.isFinite(n) && n > 0 ? n : d;
};
const envBool = k => /^(1|true|yes|on)$/i.test(String(process.env[k] || '').trim());

function die(msg, code = 2) {
  // 用同步写，避免 process.exit 时管道里的 stderr 还没刷出去
  try {
    fs.writeSync(2, msg + '\n');
  } catch {}
  process.exit(code);
}

// 中文/全角按 2 列算，保证 ls 的表格对齐
const cellWidth = s =>
  [...s].reduce(
    (n, c) => n + (/[\u1100-\u115f\u2e80-\ua4cf\uac00-\ud7a3\uf900-\ufaff\ufe30-\ufe4f\uff00-\uff60\uffe0-\uffe6]/.test(c) ? 2 : 1),
    0
  );
const padCol = (s, n) => s + ' '.repeat(Math.max(0, n - cellWidth(s)));

function baseUrl() {
  let raw = (process.env.TERMIX_URL || DEFAULT_URL).trim();
  if (!/^[a-z]+:\/\//i.test(raw)) raw = 'https://' + raw;
  const u = new URL(raw);
  if (u.protocol !== 'http:' && u.protocol !== 'https:') {
    throw new Error(`TERMIX_URL 只支持 http/https，收到 ${u.protocol}`);
  }
  u.search = '';
  u.hash = '';
  return u;
}

// 面板可能挂在子路径下（如 /termix），统一去掉结尾的 /
const pathPrefix = base => base.pathname.replace(/\/+$/, '');

function wsUrl(base) {
  const u = new URL(base.toString());
  u.protocol = base.protocol === 'http:' ? 'ws:' : 'wss:';
  u.pathname = pathPrefix(base) + '/plugin-ws/ssh-terminal/terminal';
  return u.toString();
}

function readToken() {
  if (process.env.TERMIX_TOKEN && process.env.TERMIX_TOKEN.trim()) return process.env.TERMIX_TOKEN.trim();
  const file = process.env.TERMIX_TOKEN_FILE || path.join(os.homedir(), '.termix-token');
  try {
    const t = fs.readFileSync(file, 'utf8').trim();
    if (t) return t;
  } catch (e) {
    if (e.code !== 'ENOENT') die(`读取令牌失败 ${file}: ${e.message}`);
  }
  die(
    `缺少令牌：${file} 不存在或为空\n` +
      `  用 Termix 面板生成的 API Key 写入：\n` +
      `    printf '%s' '你的APIKey' > ${file} && chmod 600 ${file}\n` +
      `  或设置环境变量 TERMIX_TOKEN`
  );
}

// ---------------------------------------------------------------- HTTP

function request(method, p, body) {
  return new Promise((resolve, reject) => {
    const mod = BASE.protocol === 'http:' ? http : https;
    const data = body === undefined ? null : Buffer.from(JSON.stringify(body), 'utf8');
    const headers = { Authorization: 'Bearer ' + TOKEN, Accept: 'application/json' };
    if (data) {
      headers['Content-Type'] = 'application/json';
      headers['Content-Length'] = data.length;
    }

    const req = mod.request(new URL(BASE.origin + pathPrefix(BASE) + p), { method, headers }, res => {
      const chunks = [];
      res.on('data', c => chunks.push(c));
      res.on('error', reject);
      res.on('end', () => {
        const text = Buffer.concat(chunks).toString('utf8');
        if (res.statusCode < 200 || res.statusCode >= 300) {
          const detail = text.trim().slice(0, 300);
          return reject(new Error(`${method} ${p} -> HTTP ${res.statusCode}${detail ? ': ' + detail : ''}`));
        }
        if (!text.trim()) return resolve(null);
        try {
          resolve(JSON.parse(text));
        } catch {
          reject(new Error(`${method} ${p} -> 返回的不是 JSON: ${text.trim().slice(0, 200)}`));
        }
      });
    });

    req.setTimeout(REQUEST_TIMEOUT * 1000, () => req.destroy(new Error(`${method} ${p} 超时（${REQUEST_TIMEOUT}s）`)));
    req.on('error', reject);
    if (data) req.end(data);
    else req.end();
  });
}

const get = p => request('GET', p, undefined);
const post = (p, body) => request('POST', p, body || {});

// ---------------------------------------------------------------- 输出解析

const strip = s =>
  s
    .replace(/\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)/g, '') // OSC
    .replace(/\x1b[P^_][^\x1b]*(?:\x1b\\)?/g, '') // DCS / PM / APC
    .replace(/\x1b\[[0-9;?<=>]*[ -/]*[@-~]/g, '') // CSI
    .replace(/\x1b[@-Z\\-_()#%][0-9A-Za-z]?/g, '') // 其它两字节转义
    .replace(/\r/g, '')
    .replace(/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/g, '');

function normalizeCode(n) {
  if (!Number.isFinite(n)) return 1;
  if (n < 0) return 255;
  return n > 255 ? 255 : n;
}

// 从带标记的原始输出里切出命令输出和退出码；没看到结束标记则返回 null
function parseOutput(text, typed = []) {
  const endAt = text.lastIndexOf(END + ':');
  const beginAt = text.indexOf(BEGIN);
  if (endAt === -1 || beginAt === -1 || beginAt > endAt) return null;

  const m = /^(-?\d+)/.exec(text.slice(endAt + END.length + 1).trimStart());
  const code = normalizeCode(m ? Number(m[1]) : NaN);

  let lines = text.slice(beginAt + BEGIN.length, endAt).split('\n');
  if (lines.length && lines[0].trim() === '') lines.shift();

  // stty -echo 生效前可能残留命令回显，只清掉开头连续的回显行，
  // 避免误删输出里恰好和命令相同的行。
  while (lines.length && typed.includes(lines[0].trim())) lines.shift();
  // 标记本身的回显（带引号的写法）不应出现在结果里
  lines = lines.filter(l => !/__TMX_\s*"(BEG|EN)"/.test(l));
  while (lines.length && lines[lines.length - 1].trim() === '') lines.pop();

  return { out: lines.join('\n'), code };
}

// ---------------------------------------------------------------- 执行

function run(hostConfig, command, opts) {
  return new Promise((resolve, reject) => {
    const ws = new WebSocket(wsUrl(BASE), {
      headers: { Authorization: 'Bearer ' + opts.ticket },
      handshakeTimeout: 20000,
      perMessageDeflate: false,
    });
    activeSocket = ws;

    const typed = command.split('\n').map(l => l.trim()).filter(Boolean);
    let buffer = '';
    let connected = false;
    let settled = false;
    let timer = null;

    const finish = (err, result) => {
      if (settled) return;
      settled = true;
      if (timer) clearTimeout(timer);
      if (activeSocket === ws) activeSocket = null;
      ws.removeAllListeners('message');
      ws.on('error', () => {});
      try { ws.terminate(); } catch {}
      err ? reject(err) : resolve(result);
    };

    const send = obj => {
      if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(obj));
    };

    timer = setTimeout(
      () => finish(new Error(`超时（${opts.timeoutSec}s），慢命令可调大 TERMIX_TIMEOUT`)),
      opts.timeoutSec * 1000
    );

    ws.on('unexpected-response', (_req, res) => finish(new Error(`WebSocket 被拒绝：HTTP ${res.statusCode}`)));
    ws.on('error', e => finish(e));
    ws.on('close', () => {
      const tail = strip(buffer).trim();
      finish(
        new Error(
          '连接在命令结束前关闭（远端可能执行了 exit/reboot，或网络中断）' +
            (tail ? '\n已收到的输出:\n' + tail.slice(-MAX_BUFFER_KEEP) : '')
        )
      );
    });

    ws.on('open', () => {
      send({ type: 'connectToHost', data: { cols: 200, rows: 50, hostConfig } });
    });

    ws.on('message', raw => {
      let m;
      try {
        m = JSON.parse(typeof raw === 'string' ? raw : raw.toString('utf8'));
      } catch {
        return;
      }
      if (!m || typeof m.type !== 'string') return;

      switch (m.type) {
        case 'host_key_verification_required': {
          const d = m.data || {};
          process.stderr.write(`[host key] 首次见到 ${d.keyType || '未知类型'}，本次连接接受（不写库）\n`);
          send({ type: 'host_key_verification_response', data: { action: 'accept' } });
          return;
        }
        case 'host_key_changed': {
          const d = m.data || {};
          if (!opts.trust) {
            return finish(
              new Error(
                'host key 变更，已拒绝。\n' +
                  `  旧: ${d.oldFingerprint || '(未知)'}\n` +
                  `  新: ${d.fingerprint || '(未知)'}\n` +
                  "  确认无误后重试：termix run --trust <目标> '<命令>'（或 TERMIX_TRUST=1）"
              )
            );
          }
          process.stderr.write('[host key] 已按 --trust 接受新 key\n');
          send({ type: 'host_key_verification_response', data: { action: 'accept' } });
          return;
        }
        case 'connected': {
          if (connected) return;
          connected = true;
          const script =
            'stty -echo 2>/dev/null; export TERM=dumb; PS1=; PS2=; PROMPT_COMMAND=;\n' +
            `printf '%s\\n' ${BEGIN_W}\n` +
            command +
            '\n' +
            `printf '%s:%s\\n' ${END_W} "$?"\n`;
          send({ type: 'input', data: script });
          return;
        }
        case 'data': {
          if (typeof m.data !== 'string' || !m.data) return;
          buffer += m.data;
          if (buffer.length > MAX_OUTPUT) {
            return finish(new Error(`输出超过 ${MAX_OUTPUT / 1024 / 1024}MB 上限，请缩小命令范围`));
          }
          if (!connected) return;
          if (!buffer.includes(END + ':')) return; // 快速跳过，避免每帧重扫
          const parsed = parseOutput(strip(buffer), typed);
          if (parsed) finish(null, parsed);
          return;
        }
        case 'error':
          return finish(new Error((m.data && m.data.message) || m.message || 'Termix 返回错误'));
        case 'password_required':
        case 'passphrase_required':
        case 'totp_required':
          return finish(new Error(`需要交互式认证（${m.type}），CLI 不处理密码/TOTP 输入`));
        default:
          return;
      }
    });
  });
}

async function execOnHost(hostConfig, command, opts) {
  const ticketRes = await post('/users/ws-ticket/api-key', {});
  const ticket = ticketRes && (ticketRes.ticket || ticketRes.token);
  if (!ticket) throw new Error('换票失败：/users/ws-ticket/api-key 响应里没有 ticket');
  return run(hostConfig, command, { ...opts, ticket });
}

// ---------------------------------------------------------------- 子命令

function usage() {
  console.error(
    `termix ${VERSION} — 通过 Termix 面板执行远端命令\n\n` +
      '用法:\n' +
      '  termix ls [--json]                        列出登记的主机\n' +
      '  termix run <id|名称|IP> <命令>            在已登记主机上执行\n' +
      '  termix run --cred <凭据id> <IP> <命令>    未登记主机（quick-connect，不写库）\n\n' +
      '选项:\n' +
      '  --trust          接受变更过的 host key\n' +
      '  --no-trust       强制拒绝变更过的 host key\n' +
      '  --cred <id>      quick-connect 使用的凭据 id\n\n' +
      '环境变量:\n' +
      '  TERMIX_TOKEN       API Key（默认读 ~/.termix-token）\n' +
      '  TERMIX_TOKEN_FILE  令牌文件路径\n' +
      '  TERMIX_URL         面板地址（默认 ' + DEFAULT_URL + '）\n' +
      '  TERMIX_TIMEOUT     单条命令超时秒数（默认 60）\n' +
      '  TERMIX_TRUST       1/true 等价于始终加 --trust\n' +
      '  TERMIX_PORT        --cred 模式端口（默认 22）\n' +
      '  TERMIX_USER        --cred 模式用户名（默认 root）'
  );
}

async function cmdLs(args) {
  const json = args.includes('--json') || args.includes('-j');
  const hosts = await get('/host/db/host');
  if (!Array.isArray(hosts)) throw new Error('/host/db/host 返回的不是数组');

  if (json) {
    console.log(JSON.stringify(hosts, null, 2));
    return;
  }
  if (!hosts.length) {
    console.log('（Termix 里还没有登记主机）');
    return;
  }
  for (const h of hosts) {
    const id = String(h.id ?? '').padStart(2);
    const name = String(h.name ?? '(未命名)');
    const user = String(h.username ?? '?');
    const ip = String(h.ip ?? '?');
    const port = h.port ?? 22;
    const folder = String(h.folder ?? '-');
    console.log(`${id}  ${padCol(name, 22)} ${user}@${ip}:${port}  [${folder}]`);
  }
}

async function cmdRun(args) {
  let trust = envBool('TERMIX_TRUST');
  let credId = null;

  while (args.length) {
    const a = args[0];
    if (a === '--') {
      args.shift();
      break;
    }
    if (!a.startsWith('--')) break;
    args.shift();
    if (a === '--trust') trust = true;
    else if (a === '--no-trust') trust = false;
    else if (a === '--cred' || a === '--credential') {
      const v = args.shift();
      if (!v || !/^\d+$/.test(v)) die('--cred 后面要跟数字凭据 id，例如：termix run --cred 2 192.168.1.10 "id"', 2);
      credId = Number(v);
    } else die(`未知参数 ${a}（支持 --trust / --no-trust / --cred <id> / --）`, 2);
  }

  const target = args.shift();
  const command = args.join(' ');
  if (!target) die('缺少目标主机（id / 名称 / IP）', 2);
  if (!command.trim()) die('缺少要执行的命令', 2);
  if (command.includes(BEGIN) || command.includes(END)) {
    die(`命令里不能包含 ${BEGIN} / ${END}（会和输出标记冲突）`, 2);
  }

  let hostConfig;
  if (credId !== null) {
    const port = envNum('TERMIX_PORT', 22);
    const username = process.env.TERMIX_USER || 'root';
    const temp = await post('/host/quick-connect', {
      ip: target,
      port,
      username,
      authType: 'credential',
      credentialId: credId,
    });
    if (!temp || !temp.ip) throw new Error('/host/quick-connect 返回异常');
    hostConfig = {
      id: 0,
      ip: temp.ip,
      port: temp.port || port,
      username: temp.username || username,
      password: temp.password,
      key: temp.key,
      keyPassword: temp.keyPassword,
      keyType: temp.keyType,
      authType: temp.authType,
    };
  } else {
    const hosts = await get('/host/db/host');
    if (!Array.isArray(hosts)) throw new Error('/host/db/host 返回的不是数组');
    const t = target.trim();
    const h =
      hosts.find(x => String(x.id) === t) ||
      hosts.find(x => (x.name || '').trim() === t) ||
      hosts.find(x => (x.name || '').trim().toLowerCase() === t.toLowerCase()) ||
      hosts.find(x => (x.ip || '').trim() === t);
    if (!h) {
      die(`找不到主机 ${target}\n  先 termix ls 看看，或用 --cred <凭据id> <IP> 走 quick-connect`, 1);
    }
    hostConfig = { id: h.id, ip: h.ip, port: h.port, username: h.username, authType: h.authType };
  }

  const timeoutSec = envNum('TERMIX_TIMEOUT', 60);
  const { out, code } = await execOnHost(hostConfig, command, { timeoutSec, trust });
  if (out) process.stdout.write(out + '\n');
  // 不要用 process.exit：管道里的大段输出会被截断
  process.exitCode = code;
}

// ---------------------------------------------------------------- main

async function main() {
  process.stdout.on('error', e => {
    if (e.code === 'EPIPE') process.exit(0);
    throw e;
  });
  process.on('SIGINT', () => {
    if (activeSocket) {
      try { activeSocket.terminate(); } catch {}
    }
    process.exit(130);
  });

  const argv = process.argv.slice(2);
  const cmd = argv.shift();

  if (cmd === '--help' || cmd === '-h' || cmd === 'help') {
    usage();
    return;
  }
  if (cmd === '--version' || cmd === '-V' || cmd === 'version') {
    console.log('termix ' + VERSION);
    return;
  }
  if (!cmd) {
    usage();
    process.exit(2);
  }
  if (cmd !== 'ls' && cmd !== 'list' && cmd !== 'run') {
    die(`未知子命令 ${cmd}\n\n（termix --help 看用法）`, 2);
  }

  BASE = baseUrl();
  TOKEN = readToken();

  if (cmd === 'ls' || cmd === 'list') {
    await cmdLs(argv);
    return;
  }
  await cmdRun(argv);
}

module.exports = { strip, parseOutput, normalizeCode, cellWidth, padCol, wsUrl, baseUrl };

if (require.main === module) {
  main().catch(e => {
    console.error('错误: ' + (e && e.message ? e.message : e));
    process.exit(1);
  });
}
