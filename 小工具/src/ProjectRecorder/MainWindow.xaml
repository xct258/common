<Window x:Class="ProjectRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProjectRecorder.Converters"
        Title="小工具" Height="640" Width="860" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" Icon="app.ico">
    <Window.Resources>
        <conv:BytesToImageConverter x:Key="BytesToImage"/>
        <conv:BytesToVisibilityConverter x:Key="BytesToVisibility"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 视图0：主界面 -->
        <Grid x:Name="ViewHome" Grid.Row="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <Button x:Name="BtnGoProjects" Content="项目管理" Height="58" FontSize="18" Style="{StaticResource BtnPrimary}" Click="BtnGoProjects_Click"/>
                <Button x:Name="BtnGoStats" Content="工作量统计" Height="58" FontSize="18" Margin="0,14,0,0" Style="{StaticResource BtnGhost}" Click="BtnGoStats_Click"/>
            </StackPanel>
        </Grid>

        <!-- 视图1：项目列表（只显示项目名称；点右上角添加后弹窗输入） -->
        <Grid x:Name="ViewProjects" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBackHome" Content="← 主界面" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnBackHome_Click"/>
                <TextBlock Grid.Column="1" Text="项目列表" Style="{StaticResource ViewTitle}"/>
                <Button x:Name="BtnAdd" Grid.Column="2" Content="＋ 添加" Width="90" Style="{StaticResource BtnPrimary}" Click="BtnAdd_Click"/>
            </Grid>

            <ListBox x:Name="LstProjects" Grid.Row="1" SelectionMode="Single"
                     Style="{StaticResource CleanList}"
                     MouseDoubleClick="LstProjects_MouseDoubleClick"
                     PreviewMouseRightButtonDown="LstProjects_RightButtonDown"
                     PreviewMouseRightButtonUp="ListBlankUp"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除该项目" Click="MenuDeleteProject_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Height="92" Margin="8" Style="{StaticResource CardBorder}">
                            <TextBlock Text="{Binding}" FontSize="24" FontWeight="Bold" Foreground="#1F2937"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 视图2：工序列表（点进项目后；首次进入空，右上角添加工序；只列工序名称） -->
        <Grid x:Name="ViewProcessList" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBackToProjects" Content="← 返回" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnBackToProjects_Click"/>
                <TextBlock x:Name="TxtProcessListTitle" Grid.Column="1" Text="项目" Style="{StaticResource ViewTitle}"/>
                <Button x:Name="BtnAddProcess" Grid.Column="2" Content="＋ 添加工序" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnAddProcess_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtProcessEmpty" Text="暂无工序，请点击右上角“＋ 添加工序”"
                           Style="{StaticResource EmptyText}" Visibility="Collapsed"/>
                <ListBox x:Name="LstProcesses" SelectionMode="Single"
                         Style="{StaticResource CleanList}"
                         MouseDoubleClick="LstProcesses_MouseDoubleClick"
                         PreviewMouseRightButtonDown="LstProcesses_RightButtonDown"
                         PreviewMouseRightButtonUp="ListBlankUp"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除该工序" Click="MenuDeleteProcess_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="170" Height="82" Margin="8" Style="{StaticResource CardBorder}">
                                <TextBlock Text="{Binding ProcessName}" FontSize="19" FontWeight="Bold" Foreground="#1F2937"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 视图3：工序详情（干净查看；双击编辑，右键排序/删除） -->
        <Grid x:Name="ViewFlow" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBackToProcessList" Content="← 返回" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnBackToProcessList_Click"/>
                <TextBlock x:Name="TxtFlowTitle" Grid.Column="1" Text="工序" Style="{StaticResource ViewTitle}"/>
                <Button x:Name="BtnAddStep" Grid.Column="2" Content="＋ 添加操作步骤" Width="130" Style="{StaticResource BtnPrimary}" Click="BtnAddStep_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtStepEmpty" Text="暂无步骤，请点击右上角“＋ 添加操作步骤”"
                           Style="{StaticResource EmptyText}" Visibility="Collapsed"/>
                <ListBox x:Name="LstSteps" SelectionMode="Single"
                         Style="{StaticResource CleanList}"
                         PreviewMouseRightButtonDown="LstSteps_RightButtonDown"
                         PreviewMouseRightButtonUp="ListBlankUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除该步骤" Click="MenuStepDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,4,8,4" Padding="12" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#111827">
                                        <Run Text="第"/><Run Text="{Binding Order}"/><Run Text="步"/>
                                    </TextBlock>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" FontSize="15" TextWrapping="Wrap"
                                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Padding="0" Margin="0,4,0,0" Cursor="IBeam" Foreground="#1F2937"/>
                                    <Image Source="{Binding ImageData, Converter={StaticResource BytesToImage}}"
                                           Visibility="{Binding ImageData, Converter={StaticResource BytesToVisibility}}"
                                           MaxHeight="240" Stretch="Uniform" HorizontalAlignment="Left"
                                           Margin="0,8,0,0" Cursor="Hand"
                                           MouseLeftButtonUp="StepImage_Click" ToolTip="点击放大查看"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 视图4：工作量统计列表（自动同步项目管理，机台操作作为最后一个） -->
        <Grid x:Name="ViewWorkloadList" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBackHomeFromWork" Content="← 主界面" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnBackHomeFromWork_Click"/>
                <TextBlock Grid.Column="1" Text="工作量统计" Style="{StaticResource ViewTitle}"/>
                <Button x:Name="BtnExport" Grid.Column="2" Content="导 出" Width="90" Style="{StaticResource BtnPrimary}" Click="BtnExport_Click"/>
            </Grid>

            <ListBox x:Name="LstWorkProjects" Grid.Row="1" SelectionMode="Single"
                     Style="{StaticResource CleanList}"
                     MouseDoubleClick="LstWorkProjects_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Height="92" Margin="8" Style="{StaticResource CardBorder}">
                            <TextBlock Text="{Binding}" FontSize="24" FontWeight="Bold" Foreground="#1F2937"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 视图5：工作量明细（工序卡片 + 快捷加数） -->
        <Grid x:Name="ViewWorkloadDetail" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBackToWorkload" Content="← 返回" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnBackToWorkload_Click"/>
                <TextBlock x:Name="TxtWorkloadTitle" Grid.Column="1" Text="工作量" Style="{StaticResource ViewTitle}"/>
                <Button x:Name="BtnAddWProcess" Grid.Column="2" Content="＋ 添加工序" Width="110" Style="{StaticResource BtnPrimary}" Click="BtnAddWProcess_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="日期：" FontSize="14" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                <Button x:Name="BtnPickDate" Width="150" Height="30" Style="{StaticResource BtnGhost}" Click="BtnPickDate_Click"/>
                <Popup x:Name="PopCalendar" PlacementTarget="{Binding ElementName=BtnPickDate}" Placement="Bottom"
                       StaysOpen="False">
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="6">
                        <Calendar x:Name="CalWork" SelectionMode="SingleDate" SelectedDatesChanged="CalWork_SelectedDatesChanged"/>
                    </Border>
                </Popup>
                <TextBlock x:Name="TxtWSummary" Text="累计完成：0" FontSize="15" FontWeight="Bold" Foreground="#1D4ED8"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <TextBlock x:Name="TxtWProcessEmpty" Text="暂无工序，请点击右上角“＋ 添加工序”"
                           Style="{StaticResource EmptyText}" Visibility="Collapsed"/>
                <ListBox x:Name="LstWorkProcess" SelectionMode="Single"
                         Style="{StaticResource CleanList}"
                         PreviewMouseRightButtonDown="LstWorkProcess_RightButtonDown"
                         PreviewMouseRightButtonUp="ListBlankUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="上移" Click="MenuWProcessUp_Click"/>
                            <MenuItem Header="下移" Click="MenuWProcessDown_Click"/>
                            <MenuItem Header="删除该工序" Click="MenuDeleteWProcess_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,5,8,5" Padding="12,10" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Process.ProcessName}" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
                                        <TextBlock FontSize="13" Foreground="#6B7280" Margin="0,4,0,0">
                                            <Run Text="累计："/><Run Text="{Binding TotalQty}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="−" Width="36" Height="32" Style="{StaticResource BtnGhost}" Click="BtnWCardMinus_Click"/>
                                        <TextBox x:Name="QtyBox" Text="1" Width="70" Height="32" Margin="6,0,0,0"
                                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                 PreviewTextInput="TxtQty_PreviewTextInput"/>
                                        <Button Content="＋" Width="36" Height="32" Margin="6,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnWCardPlus_Click"/>
                                        <Button Content="添 加" Width="90" Height="32" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}" Click="BtnWCardSave_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

        </Grid>
    </Grid>
</Window>
