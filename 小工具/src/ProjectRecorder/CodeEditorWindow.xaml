<Window x:Class="ProjectRecorder.CodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="在线编辑" Height="640" Width="920" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Icon="app.ico"
        Closing="Window_Closing">
    <!-- Ctrl+S 保存 -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="SaveCommand_Executed" CanExecute="SaveCommand_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Key="S" Modifiers="Ctrl"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- 深色次按钮：仿 VS Code 工具栏按钮（覆盖应用级白底浅色 BtnGhost 只在主窗口用） -->
        <Style x:Key="EditorGhost" TargetType="Button">
            <Setter Property="Background" Value="#3A3D41"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45494E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2D2F33"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2D2F33"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色滚动条：覆盖应用级浅色滚动条（仅本窗口生效） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" MinWidth="12">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#4D4D52"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#606066"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#80808A"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：文件名 + 语言/编码 + 操作按钮 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="TxtFileName" FontSize="14" FontWeight="Bold"
                           Foreground="#D4D4D4" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtFileInfo" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkPreview" Content="预览" FontSize="12" Foreground="#9CA3AF"
                          VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                          Checked="ChkPreview_Changed" Unchecked="ChkPreview_Changed"
                          ToolTip="Markdown 实时预览"/>
                <CheckBox x:Name="ChkWrap" Content="自动换行" FontSize="12" Foreground="#9CA3AF"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="ChkWrap_Changed" Unchecked="ChkWrap_Changed"/>
                <Button Content="保 存" Width="86" Style="{StaticResource BtnPrimary}"
                        Click="BtnSave_Click" ToolTip="Ctrl+S"/>
                <Button Content="关 闭" Width="86" Margin="8,0,0,0" Style="{StaticResource EditorGhost}"
                        Click="BtnClose_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- 编辑器：AvalonEdit，行号 + VS Code Dark+ 风格语法高亮；md 可右侧实时预览 -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#303031"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PreviewSplitterCol" Width="0"/>
                    <ColumnDefinition x:Name="PreviewCol" Width="0"/>
                </Grid.ColumnDefinitions>
                <avalonedit:TextEditor x:Name="Editor" Grid.Column="0"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                       FontSize="14"
                                       ShowLineNumbers="True"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4"
                              HorizontalAlignment="Stretch" Background="#303031" Visibility="Collapsed"/>
                <Border x:Name="PreviewPane" Grid.Column="2" Background="#1E1E1E" Visibility="Collapsed">
                    <WebBrowser x:Name="PreviewBrowser"/>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏：光标位置 + 语言/编码/修改状态 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="TxtCursor" FontSize="11" Foreground="#9CA3AF"/>
            <TextBlock x:Name="TxtMeta" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>