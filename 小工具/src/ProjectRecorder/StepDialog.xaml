<Window x:Class="ProjectRecorder.StepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作步骤" Height="470" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="步骤内容 *" FontSize="13" FontWeight="Bold" Foreground="#374151"/>
        <TextBox x:Name="TxtStep" Height="32" Margin="0,8,0,0" VerticalContentAlignment="Center" MaxLength="500"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
            <TextBlock Text="配图" FontSize="13" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
            <Button x:Name="BtnPickImage" Content="插入图片…" Width="104" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnPickImage_Click"/>
            <Button x:Name="BtnClearImage" Content="移除" Width="70" Margin="8,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnClearImage_Click"/>
        </StackPanel>
        <StackPanel x:Name="PanelImagePreview" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtImageInfo" FontSize="12" Foreground="#9CA3AF"/>
            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="6" MaxHeight="150" Background="White">
                <Image x:Name="ImgPreview" Stretch="Uniform" MaxHeight="134"/>
            </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
